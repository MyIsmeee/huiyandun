# 唯一对外入口（C-OPS-05、D-02）：提供前端页面，同源反向代理 /api、/ws 到 api-server
# 证书由 Caddy 内置本地 CA 签发，根证书由 make console-ca 导出后导入浏览器信任库（ops.md §5）
{
	admin off
	persist_config off
	skip_install_trust
	auto_https disable_redirects
	# 容器内以非 root 运行，监听非特权端口，由 Compose 映射到宿主机 443（C-OPS-04）
	https_port 8443
	# 浏览器访问 IP 时不发送 SNI；经端口映射到达时本地地址是容器 IP，须指定默认证书。
	# HYD_LAN_IP 为本机局域网地址（ops.md §5），未设时为 127.0.0.1
	default_sni {$HYD_LAN_IP}
}

# 本机与局域网浏览器访问（ops.md §5）；只为列出的地址签发，内置 CA 不访问任何外部地址
localhost, 127.0.0.1, {$HYD_LAN_IP} {
	tls internal

	handle /api/* {
		reverse_proxy api-server:8000
	}
	handle /ws {
		reverse_proxy api-server:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
