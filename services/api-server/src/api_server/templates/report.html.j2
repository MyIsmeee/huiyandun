<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>溯源报告：{{ title }}</title>
{# 只用系统字体、不引用任何外部资源（G-05）；打印为 PDF 时水印逐页可见（V-AI4） #}
<style>
  body { margin: 32px auto; max-width: 960px; padding: 0 24px; color: #1f2328; background: #fff;
    font: 14px/1.6 system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; }
  h1 { margin: 0 0 4px; font-size: 22px; }
  h2 { margin: 0 0 12px; font-size: 17px; }
  h3 { margin: 16px 0 6px; font-size: 14px; }
  .meta, .note, .missing { color: #59636e; }
  .meta, .note { font-size: 13px; }
  .missing { font-style: italic; }
  .ai-label { position: sticky; top: 0; z-index: 1; margin: 0 0 8px; padding: 4px 0; background: #fff; }
  .unverified { color: #59636e; text-decoration: underline dashed; text-underline-offset: 3px; cursor: help; }
  section { margin-top: 20px; padding: 16px 20px; border: 1px solid #d1d9e0; border-radius: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 6px 8px; border-bottom: 1px solid #eaeef2; text-align: left; vertical-align: top; }
  th { color: #59636e; font-weight: 500; white-space: nowrap; }
  .kv th { width: 9em; }
  ul { margin: 0; padding-left: 20px; }
  .watermark { position: fixed; inset: -50%; z-index: 10; display: flex; flex-wrap: wrap;
    gap: 96px 160px; align-content: space-around; justify-content: space-around; transform: rotate(-30deg);
    color: #000; opacity: .08; font-size: 32px; font-weight: 700; pointer-events: none; }
  @media print { body { margin: 0 auto; } section { break-inside: avoid; } }
</style>
</head>
<body>
{% if not report.reviewed_by %}
<div class="watermark" aria-hidden="true">{% for _ in range(60) %}<span>未复核草稿</span>{% endfor %}</div>
{% endif %}
<header>
  <h1>溯源报告：{{ title }}</h1>
  <p class="meta">报告编号 {{ report.id }} · 生成于 {{ created_at }} · {{ "模板生成" if report.source == "template" else "模型生成：" ~ ai.by }} ·
  {% if report.reviewed_by %}已复核：{{ report.reviewed_by }} 于 {{ reviewed_at }}{% else %}未复核草稿{% endif %}</p>
</header>

<section aria-label="事实区">
  <h2>事实区</h2>
  <h3>事件概要</h3>
  <table class="kv">
  {% for label, value in summary %}
    <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
  {% endfor %}
  </table>
  <h3>命中路径</h3>
  <table>
    <tr><th>时间</th><th>类型</th><th>内容</th><th>来源</th></tr>
  {% for e in timeline %}
    <tr{% if e.missing %} class="missing"{% endif %}><td>{{ e.ts }}</td><td>{{ e.kind }}</td><td>{{ e.text }}</td><td>{{ e.source }}</td></tr>
  {% endfor %}
  </table>
  <h3>证据引用</h3>
  {% if evidence_refs %}
  <ul>{% for ref in evidence_refs %}<li>{{ ref }}</li>{% endfor %}</ul>
  {% else %}
  <p class="note">无</p>
  {% endif %}
  <h3>处置记录</h3>
  {% if executions %}
  <ul>{% for line in executions %}<li>{{ line }}</li>{% endfor %}</ul>
  {% else %}
  <p class="note">未执行自动处置</p>
  {% endif %}
</section>

<section aria-label="AI 分析区">
  <h2>AI 分析区</h2>
  {% if ai %}
  <p class="note ai-label">AI 生成 · 需人工复核 · 由 {{ ai.by }} 生成{% if ai.has_unverified %} · 虚线下划线为未能在证据中溯源的实体{% endif %}</p>
  <h3>摘要</h3>
  <p>{{ ai.summary }}</p>
  {% for title, items in [("攻击链", ai.attack_chain), ("影响", ai.impact), ("建议（仅作文字建议，系统不会据此执行任何操作）", ai.recommendations)] %}
  <h3>{{ title }}</h3>
  {% if items %}
  <ul>{% for item in items %}<li>{{ item }}</li>{% endfor %}</ul>
  {% else %}
  <p class="note">无</p>
  {% endif %}
  {% endfor %}
  <h3>可信度</h3>
  <p>{{ ai.confidence }}</p>
  {% else %}
  <p class="note">模型不可用，以下为规则模板生成（原因：{{ report.degraded_reason }}）</p>
  <p>{{ narrative }}</p>
  {% endif %}
</section>
</body>
</html>
