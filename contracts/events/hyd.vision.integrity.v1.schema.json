{
  "title": "VisionIntegrityV1",
  "description": "画面完整性异常（生产者 vision-engine）",
  "allOf": [{ "$ref": "event_base.schema.json" }],
  "type": "object",
  "required": ["camera_id", "type", "duration_s"],
