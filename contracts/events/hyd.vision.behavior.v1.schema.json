{
  "title": "VisionBehaviorV1",
  "description": "骨骼行为事件（生产者 vision-engine）",
  "allOf": [{ "$ref": "event_base.schema.json" }],
  "type": "object",
  "required": [
    "camera_id",
    "track_id",
    "behavior",
    "confidence_avg",
    "duration_s",
    "ts_start",
    "ts_end"
  ],
  "properties": {
    "camera_id": { "type": "string" },
    "track_id": { "type": "integer" },
    "behavior": { "enum": ["fall", "climb"] },
    "level": {
      "enum": ["suspected", "confirmed"],
      "default": "confirmed",
      "description": "1.1 起。suspected 为疑似跌倒（倒地满 2 s），只在控制台提示，不进入物理告警、不参与关联；confirmed 为确认（倒地且基本不动满 8 s），进入物理告警。攀爬只有 confirmed；1.0 的事件没有此字段，按 confirmed"
    },
    "confidence_avg": { "type": "number", "minimum": 0, "maximum": 1 },
    "duration_s": { "type": "number", "minimum": 0 },
    "ts_start": { "type": "string", "format": "date-time" },
    "ts_end": { "type": "string", "format": "date-time" }
  }
}
