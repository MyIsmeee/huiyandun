{
  "title": "SceneFrame",
  "description": "摄像头画面中识别到的环境，已投影到平面（spec.md FR-909）：平面坐标（米）的多边形与线段，另可附去除人员后的实景底图（backdrop）；只在生成场景初稿时识别一次，不持久化（D-133、architecture.md §12）。地面、物体与标线的多边形合计不超过 64 个",
  "type": "object",
  "required": ["camera_id", "surfaces", "walls", "objects", "trees", "markings"],
  "properties": {
    "camera_id": { "type": "string" },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon"],
        "properties": {
          "class": { "enum": ["road", "sidewalk", "floor", "grass", "earth"] },
          "polygon": { "$ref": "#/$defs/Polygon" }
        }
      },
      "description": "地面色块"
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "line", "height_m"],
        "properties": {
          "class": { "enum": ["wall", "building", "fence", "railing", "board"] },
          "line": { "$ref": "#/$defs/Line" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "立面：沿墙脚线挤出，高度按类别取默认值。board 为黑板（含投影幕、公告板），line 为其下方的墙脚线，板面离地 0.9 m、高 height_m"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon", "height_m"],
        "properties": {
          "class": { "enum": ["table", "chair", "cabinet", "sofa", "bed", "furniture", "street_furniture", "appliance", "box", "fixture"] },
          "polygon": { "$ref": "#/$defs/Polygon" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 },
          "base_m": { "type": "number", "minimum": 0, "description": "底部离地高度（米）：放在桌面、柜顶上的小件物品（appliance、box）才有，大屏据此摆放；缺省为落地" },
          "kind": {
            "enum": [
              "table", "desk", "coffee_table",
              "chair", "armchair", "seat", "swivel_chair", "stool",
              "cabinet", "shelf", "wardrobe", "chest_of_drawers", "bookcase",
              "sofa", "bed", "counter",
              "signboard", "bench", "streetlight", "pole", "traffic_light", "ashcan",
              "computer", "crt_screen", "monitor", "television",
              "refrigerator", "washer", "microwave", "oven", "stove", "dishwasher", "lamp", "fan",
              "box", "bag", "basket",
              "toilet", "sink", "bathtub", "shower"
            ],
            "description": "细分类别：分割模型（ADE20K）在该物体上点数最多的原始类别，如桌子中的书桌、茶几，椅子中的转椅、凳子，柜子中的书架、衣柜、斗柜；缺省时只按 class 与尺寸呈现"
          }
        }
      },
      "description": "物体的底面轮廓：电器（appliance）、箱包（box）、卫浴（fixture）按细分类别摆放模型库中的对应模型；桌、椅、柜、沙发、床以家具模型沿轮廓排开；其余家具（furniture）与街道设施由轮廓挤出 height_m 高的低矮立体块。自动场景按 kind 与实测长宽高选择画法（书桌、茶几、圆桌、转椅、凳子、书架、衣柜等）"
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "height_m"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "植被：树干底部中心"
    },
    "markings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon"],
        "properties": {
          "class": { "enum": ["crosswalk", "lane"] },
          "polygon": { "$ref": "#/$defs/Polygon" }
        }
      },
      "description": "路面区域内的白色标线"
    },
    "backdrop": {
      "type": "object",
      "required": ["cols", "rows", "points", "quads", "image"],
      "properties": {
        "cols": { "type": "integer", "minimum": 2, "maximum": 256 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 256 },
        "points": { "type": "array", "items": { "type": "number" }, "description": "rows × cols × 3 个数：每点平面 x、离地高度、平面 y（米），行优先" },
        "quads": { "type": "string", "contentEncoding": "base64", "description": "(rows−1)×(cols−1) 位的位图，行优先、每字节高位在前：相邻四点围成的格子是否保留（深度突变、超出范围、行人车辆所在处不保留）；不保留的格子用到的点坐标为 0" },
        "image": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/jpeg", "description": "去除行人与车辆（按检测框与分割遮去后修补）的画面" }
      },
      "description": "实景底图（可选）：画面按 cols × rows 网格取点的三维位置与去除人员后的画面，网格点 (i, j) 对应画面归一化坐标 ((j + 0.5) / cols, (i + 0.5) / rows)。只在内存中随识别结果传递，不持久化"
    }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "平面坐标 [x, y]，单位米"
    },
    "Polygon": { "type": "array", "items": { "$ref": "#/$defs/Point" }, "minItems": 3 },
    "Line": { "type": "array", "items": { "$ref": "#/$defs/Point" }, "minItems": 2 }
  }
}
