{
  "title": "SceneFrame",
  "description": "摄像头实时识别的环境，已投影到平面（HYD-REQ-006 FR-108）：只含平面坐标（米）的多边形与线段，不含图像；每台摄像头每秒 1 帧，只保留最新一帧，不持久化（HYD-PLAN-007 §1）。地面、物体与标线的多边形合计不超过 64 个",
  "type": "object",
  "required": ["camera_id", "surfaces", "walls", "objects", "trees", "markings"],
  "properties": {
    "camera_id": { "type": "string" },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon"],
        "properties": {
          "class": { "enum": ["road", "sidewalk", "floor", "grass", "earth"] },
          "polygon": { "$ref": "#/$defs/Polygon" }
        }
      },
      "description": "地面色块"
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "line", "height_m"],
        "properties": {
          "class": { "enum": ["wall", "building", "fence", "railing", "board"] },
          "line": { "$ref": "#/$defs/Line" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "立面：沿墙脚线挤出，高度按类别取默认值。board 为黑板（含投影幕、公告板），line 为其下方的墙脚线，板面离地 0.9 m、高 height_m"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon", "height_m"],
        "properties": {
          "class": { "enum": ["table", "chair", "cabinet", "sofa", "bed", "furniture", "street_furniture"] },
          "polygon": { "$ref": "#/$defs/Polygon" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "物体的底面轮廓：桌、椅、柜、沙发、床以家具模型沿轮廓排开；其余家具（furniture）与街道设施由轮廓挤出 height_m 高的低矮立体块"
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "height_m"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "植被：树干底部中心"
    },
    "markings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "polygon"],
        "properties": {
          "class": { "enum": ["crosswalk", "lane"] },
          "polygon": { "$ref": "#/$defs/Polygon" }
        }
      },
      "description": "路面区域内的白色标线"
    }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "平面坐标 [x, y]，单位米"
    },
    "Polygon": { "type": "array", "items": { "$ref": "#/$defs/Point" }, "minItems": 3 },
    "Line": { "type": "array", "items": { "$ref": "#/$defs/Point" }, "minItems": 2 }
  }
}
