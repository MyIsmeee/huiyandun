{
  "title": "SiteConfig",
  "description": "站点配置 site.yaml：站点尺寸（首次启动时建默认场景区域，D-124）、摄像头（只在摄像头登记表为空时初始导入，D-101）、部署模式与核心业务白名单（spec.md FR-901）",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "cameras", "whitelist"],
  "properties": {
    "site": { "$ref": "#/$defs/SiteInfo" },
    "cameras": { "type": "array", "items": { "$ref": "#/$defs/CameraConfig" } },
    "whitelist": {
      "type": "array",
      "description": "核心业务地址段，不得被处置（C-SEC-03）",
      "items": {
        "anyOf": [
          { "type": "string", "format": "ipv4-network" },
          { "type": "string", "format": "ipv6-network" }
        ]
      }
    }
  },
  "$defs": {
    "SiteInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "width_m", "height_m", "mode"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "width_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_m": { "type": "number", "exclusiveMinimum": 0 },
        "mode": {
          "enum": ["bypass", "host_probe"],
          "description": "部署模式，整个站点统一（architecture.md §6）；设备的 mode 取此值"
        }
      }
    },
    "CameraConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ip", "pose"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "显示名称；省略时取 id" },
        "ip": {
          "anyOf": [{ "type": "string", "format": "ipv4" }, { "type": "string", "format": "ipv6" }]
        },
        "source": {
          "$ref": "#/$defs/SourceConfig",
          "description": "拉流地址（不含凭据），初始导入摄像头登记表时使用；省略时为推流（D-101）"
        },
        "pose": { "$ref": "#/$defs/PoseConfig" },
        "calibration": {
          "type": "array",
          "description": "标定点 [u, v, x, y]：像素坐标与平面坐标；省略或少于 4 组时按 pose 估算地面映射（FR-902、D-102）",
          "default": [],
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        },
        "climb_lines": {
          "type": "array",
          "description": "禁止攀爬警戒线 [u1, v1, u2, v2]：沿墙顶或栏杆顶在画面中画的线段，像素坐标；脚踝从线下方越到上方并持续 2 s 即为攀爬（FR-104）。省略视为无",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        }
      }
    },
    "SourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "host", "port", "path"],
      "properties": {
        "protocol": { "enum": ["rtsp", "rtmp", "http", "onvif"] },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string" }
      }
    },
    "PoseConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "height_m", "yaw_deg", "pitch_deg", "hfov_deg", "range_m"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "height_m": { "type": "number" },
        "yaw_deg": { "type": "number" },
        "pitch_deg": { "type": "number" },
        "hfov_deg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "range_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
